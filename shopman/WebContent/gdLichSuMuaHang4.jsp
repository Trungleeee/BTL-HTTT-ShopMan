<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="WEB-INF/request-context.jspf" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><base href="<%= request.getContextPath() %>/"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Lịch sử mua hàng • ShopMan</title><link rel="icon" href="assets/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="assets/style.css"></head><body data-role="manager"><div id="shell"></div><template id="page"><div id="history-content" aria-live="polite"></div></template><script src="assets/mock-data.js"></script><script type="application/json" id="shopman-context"><%= request.getAttribute("shopmanContext") %></script><script src="assets/routes.js"></script><script src="assets/ui.js"></script><script>
(async () => { if (UI.auth.user?.role !== 'manager') return; const period = UI.period(), customerId = UI.params.get('customerId'), back = UI.url('customerRevenue', period); try {
  ShopData.validatePeriod(period.ngayBatDau, period.ngayKetThuc);
  const customer = await ShopData.getCustomer(customerId);
  if (!customer) throw new Error('Không tìm thấy khách hàng. Vui lòng quay lại bảng thống kê và chọn khách hàng hợp lệ.');
  const orders = await ShopData.getHoaDonCuaKhachHang(customerId, period.ngayBatDau, period.ngayKetThuc), total = orders.reduce((s,o) => s + o.totalAmount, 0);
  document.querySelector('#history-content').innerHTML = `<div class="page-heading"><div><h1>Lịch sử mua hàng</h1><p>Kỳ thống kê: ${UI.date(period.ngayBatDau)} – ${UI.date(period.ngayKetThuc)}</p></div><a class="btn secondary" href="${UI.esc(back)}">Quay lại thống kê</a></div><section class="panel"><div class="customer-summary"><div><h2>${UI.esc(customer.fullName)}</h2><p>${UI.esc(customer.customerCode)} </p></div><div class="customer-contacts"><div><small>Điện thoại</small><strong>${UI.esc(customer.phoneNumber)}</strong></div><div><small>Email</small><strong>${UI.esc(customer.email)}</strong></div></div></div><p class="muted" style="font-size:13px;margin:0">Địa chỉ mặc định: ${UI.esc(customer.defaultShippingAddress)}</p></section><div class="panel-header"><div><h2>Các lần mua hàng</h2></div></div>${orders.length ? `<div class="table-wrap"><table><caption class="hidden">Lịch sử hóa đơn đã giao của khách hàng</caption><thead><tr><th scope="col">STT</th><th scope="col">Mã hóa đơn</th><th scope="col">Ngày đặt</th><th scope="col" class="number">Tổng tiền</th><th scope="col">Trạng thái</th><th scope="col">Chi tiết</th></tr></thead><tbody>${orders.map((o,i)=>`<tr><td class="muted">${String(i+1).padStart(2,'0')}</td><td><strong>${UI.esc(o.orderCode)}</strong></td><td class="muted">${UI.date(o.orderDate)}</td><td class="number price">${UI.money(o.totalAmount)}</td><td>${UI.status(o.status)}</td><td>${UI.selection('invoice', { orderId: o.id, customerId, ...period }, 'Xem chi tiết', { label: 'Xem hóa đơn ' + o.orderCode })}</td></tr>`).join('')}</tbody><tfoot><tr><td colspan="3"><strong>Tổng doanh thu trong kỳ</strong></td><td class="number price">${UI.money(total)}</td><td colspan="2"></td></tr></tfoot></table></div>` : UI.empty('Chưa có hóa đơn trong kỳ','Khách hàng này chưa có hóa đơn đã giao trong khoảng thời gian đang xem.')}`;
} catch (err) { UI.error(err.message, document.querySelector('#history-content')); document.querySelector('#history-content').insertAdjacentHTML('beforeend', `<a class="btn secondary" href="${UI.esc(back)}">Quay lại thống kê</a>`); } })();
</script></body></html>
