<%@ page isELIgnored="true" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="WEB-INF/request-context.jspf" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><base href="<%= request.getContextPath() %>/"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chi tiết hóa đơn • ShopMan</title><link rel="icon" href="assets/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="assets/style.css"></head><body data-role="manager"><div id="shell"></div><template id="page"><div id="invoice-content" aria-live="polite"></div></template><script type="application/json" id="shopman-context"><%= request.getAttribute("shopmanContext") %></script><script src="assets/database-data.js"></script><script src="assets/routes.js"></script><script src="assets/ui.js?v=3"></script><script>
(async () => { if (UI.auth.user?.role !== 'manager') return; const period = UI.period(), customerId = UI.params.get('customerId'), back = UI.url('purchaseHistory',{customerId:customerId || '',...period}); try {
  const order = await ShopData.getHoaDonTrongKy(UI.params.get('orderId'), customerId, period.ngayBatDau, period.ngayKetThuc);
  if (!order) throw new Error('Không tìm thấy hóa đơn thuộc khách hàng và kỳ thống kê đã chọn.');
  const details = await ShopData.getChiTietHoaDon(order.id, customerId, period.ngayBatDau, period.ngayKetThuc);
  const total = details.reduce((s,d)=>s+d.quantity*d.unitPrice,0);
  document.title = 'Hóa đơn ' + order.orderCode + ' • ShopMan';
  document.querySelector('#invoice-content').innerHTML = `<div class="page-heading"><div><h1>Chi tiết hóa đơn</h1></div><div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn secondary" href="${UI.esc(back)}">Quay lại</a></div></div><article class="panel"><div class="panel-header"><div><h2 style="font-size:22px;margin:0">${UI.esc(order.orderCode)}</h2><p>Ngày đặt: ${UI.date(order.orderDate)} · ${order.orderDate.slice(11,16)}</p></div>${UI.status(order.status)}</div><div class="invoice-grid"><div><h3>Khách hàng</h3><strong>${UI.esc(order.customer.fullName)}</strong><p>${UI.esc(order.customer.customerCode)} · ${UI.esc(order.customer.phoneNumber)}</p><p>${UI.esc(order.customer.email)}</p></div><div><h3>Giao hàng</h3><strong>${UI.esc(order.shippingAddress)}</strong><p>Nhân viên xử lý: ${UI.esc(order.salesStaff.fullName)} (${UI.esc(order.salesStaff.employeeCode)})</p></div></div><div class="table-wrap"><table><caption class="hidden">Các mặt hàng trong hóa đơn ${UI.esc(order.orderCode)}</caption><thead><tr><th scope="col">STT</th><th scope="col">Mặt hàng</th><th scope="col" class="number">Số lượng</th><th scope="col" class="number">Đơn giá mua</th><th scope="col" class="number">Thành tiền</th></tr></thead><tbody>${details.map((d,i)=>`<tr><td class="muted">${i+1}</td><td><div class="cell-product"><img src="${UI.esc(d.product.imageUrl)}" alt=""><div><strong>${UI.esc(d.product.productName)}</strong><small>${UI.esc(d.product.productCode)}</small></div></div></td><td class="number">${d.quantity}</td><td class="number">${UI.money(d.unitPrice)}</td><td class="number price">${UI.money(d.quantity*d.unitPrice)}</td></tr>`).join('')}</tbody></table></div><div class="invoice-total"><div><p><span>Số dòng mặt hàng</span><strong>${details.length}</strong></p><p><span>Tổng số lượng</span><strong>${details.reduce((s,d)=>s+d.quantity,0)}</strong></p><p class="grand-total"><span>Tổng tiền</span><span>${UI.money(total)}</span></p></div></div></article>`;
} catch (err) { UI.error(err.message,document.querySelector('#invoice-content')); document.querySelector('#invoice-content').insertAdjacentHTML('beforeend',`<a class="btn secondary" href="${UI.esc(back)}">Quay lại lịch sử mua hàng</a>`); } })();
</script></body></html>
