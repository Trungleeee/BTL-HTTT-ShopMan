@startuml
top to bottom direction

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor black
skinparam ArrowFontColor black
skinparam ArrowThickness 1
skinparam nodesep 80
skinparam ranksep 100

actor "Customer4" as Customer

together {
    boundary "CustomerHomeView4" as Home
    boundary "ProductSearchView4" as Search
    boundary "ProductDetailView4" as Details
}

entity "Product4" as Product

' Customer interactions
Customer -down- Home : 1: select search ↓

Customer -down- Search : 3: show search ↑\n4: search(keyword) ↓\n8: show results ↑\n9: select(productId) ↓

Customer -down- Details : 14: show details ↑

' View interactions
Home -right- Search : 2: call →
Search -right- Details : 10: call →

' Calls and returned results
Search -down- Product : 5: call ↓\n7: return products ↑

Details -down- Product : 11: call ↓\n13: return details ↑

' Entity self-messages
Product -left-> Product : 6: getProductsByKeyword(keyword)\n12: getProductDetails(product)

@enduml