@startuml

top to bottom direction

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor black
skinparam ArrowFontColor black
skinparam ArrowThickness 1
skinparam nodesep 80
skinparam ranksep 110

actor "Manager4" as Manager

together {
    boundary "ManagerHomeView4" as Home
    boundary "StatisticsSelectionView4" as Selection
    boundary "CustomerRevenueStatisticsView4" as Statistics
    boundary "CustomerPurchaseHistoryView4" as History
    boundary "SalesOrderDetailView4" as Details
}

together {
    entity "Customer4" as Customer
    entity "SalesOrder4" as Order
    entity "SalesOrderDetail4" as OrderDetail
}

' Manager interactions
Manager -down- Home : 1: select statistics ↓

Manager -down- Selection : 3: show statistics types ↑\n4: select customer revenue ↓

Manager -down- Statistics : 6: show date inputs ↑\n7: enter dates and view statistics ↓\n11: show revenues ↑\n12: select customer ↓

Manager -down- History : 17: show customer, dates and orders ↑\n18: select order ↓

Manager -down- Details : 23: show order details ↑

' View interactions
Home -right- Selection : 2: call →
Selection -right- Statistics : 5: call →
Statistics -right- History : 13: call →
History -right- Details : 19: call →

' Calls and returned results
Statistics -down- Customer : 8: call ↓\n10: return customer revenues ↑

History -down- Order : 14: call ↓\n16: return orders ↑

Details -down- OrderDetail : 20: call ↓\n22: return order details ↑

' Entity self-messages
Customer -left-> Customer : 9: getCustomerRevenueStatistics(startDate, endDate)

Order -left-> Order : 15: getOrdersByCustomer(customer, startDate, endDate)

OrderDetail -left-> OrderDetail : 21: getOrderDetails(salesOder)

' Hidden links for entity alignment only
Customer -[hidden]right-> Order
Order -[hidden]right-> OrderDetail

@enduml