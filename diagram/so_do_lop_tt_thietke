@startuml

top to bottom direction

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 0
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 55
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor black
skinparam classBorderColor black
skinparam classBackgroundColor white
skinparam padding 3

hide circle
hide methods

' ===================================
' 1. THÀNH VIÊN VÀ KẾ THỪA
' ===================================

abstract class Member4 {
    - id : int
    - username : String
    - password : String
    - fullName : String
    - dateOfBirth : LocalDate
    - address : String
    - phoneNumber : String
    - email : String
    - role : String
    - note : String
}

together {
    class Manager4 {
        - employeeCode : String
        - position : String
    }

    class SalesStaff4 {
        - employeeCode : String
        - workShift : String
    }

    class Customer4 {
        - customerCode : String
        - defaultShippingAddress : String
        - loyaltyPoints : int
    }
}

' ===================================
' 2. DANH MỤC, SẢN PHẨM, NHÀ CUNG CẤP
' ===================================

class Category4 {
    - id : int
    - categoryCode : String
    - categoryName : String
    - description : String
}

class Product4 {
    - id : int
    - productCode : String
    - productName : String
    - sellingPrice : BigDecimal
    - stockQuantity : int
    - description : String
    - imageUrl : String
    - unit : String
    - category : Category4
}

class Supplier4 {
    - id : int
    - supplierCode : String
    - supplierName : String
    - address : String
    - phoneNumber : String
    - email : String
    - description : String
}

' ===================================
' 3. GIỎ HÀNG
' ===================================

class ShoppingCart4 {
    - id : int
    - cartCode : String
    - customer : Customer4
    - items : List<CartItem4>
}

class CartItem4 {
    - id : int
    - quantity : int
    - product : Product4
}

' ===================================
' 4. HÓA ĐƠN BÁN
' ===================================

class SalesOrder4 {
    - id : int
    - orderCode : String
    - orderDate : LocalDateTime
    - status : String
    - shippingAddress : String
    - /totalAmount : BigDecimal
    - customer : Customer4
    - approvedBy : SalesStaff4
    - details : List<SalesOrderDetail4>
}

class SalesOrderDetail4 {
    - id : int
    - detailCode : String
    - quantity : int
    - unitPrice : BigDecimal
    - /lineTotal : BigDecimal
    - product : Product4
}

' ===================================
' 5. HÓA ĐƠN NHẬP
' ===================================

class ImportInvoice4 {
    - id : int
    - invoiceNumber : String
    - importDate : LocalDateTime
    - /totalAmount : BigDecimal
    - supplier : Supplier4
    - createdBy : Manager4
    - details : List<ImportInvoiceDetail4>
}

class ImportInvoiceDetail4 {
    - id : int
    - detailCode : String
    - quantity : int
    - importPrice : BigDecimal
    - /lineTotal : BigDecimal
    - product : Product4
}

' ===================================
' 6. THỐNG KÊ KHÁCH HÀNG
' ===================================

class CustomerRevenueStatistics4  {
    - /totalRevenue : BigDecimal
    - /orderCount : int
}

' ===================================
' 7. QUAN HỆ KẾ THỪA
' ===================================

Member4 <|-- Manager4
Member4 <|-- SalesStaff4
Member4 <|-- Customer4

Customer4 <|-right- CustomerRevenueStatistics4

' ===================================
' 8. ASSOCIATION
' ===================================

Product4 "0..*" -down- "1" Category4

ShoppingCart4 "1" -up- "1" Customer4

SalesOrder4 "0..*" -up- "1" Customer4
SalesOrder4 "0..*" -up- "0..1" SalesStaff4

ImportInvoice4 "0..*" -up- "1" Supplier4
ImportInvoice4 "0..*" -up- "1" Manager4

' ===================================
' 9. COMPOSITION
' Hình thoi đen tại giỏ hàng/hóa đơn
' ===================================

ShoppingCart4 "1" *-down- "0..*" CartItem4

SalesOrder4 "1" *-down- "1..*" SalesOrderDetail4

ImportInvoice4 "1" *-down- "1..*" ImportInvoiceDetail4

' ===================================
' 10. AGGREGATION
' Hình thoi trắng tại lớp chi tiết
' ===================================

CartItem4 "0..*" o-- "1" Product4

SalesOrderDetail4 "0..*" o-down- "1" Product4

ImportInvoiceDetail4 "0..*" o-- "1" Product4

' ===================================
' 11. RÀNG BUỘC BỐ CỤC
' Không phải quan hệ nghiệp vụ
' ===================================

Manager4 -[hidden]right- SalesStaff4
SalesStaff4 -[hidden]right- Customer4

ImportInvoice4 -[hidden]right- SalesOrder4
SalesOrder4 -[hidden]right- ShoppingCart4

ImportInvoiceDetail4 -[hidden]right- SalesOrderDetail4
SalesOrderDetail4 -[hidden]right- CartItem4

Supplier4 -[hidden]down- ImportInvoice4

@enduml