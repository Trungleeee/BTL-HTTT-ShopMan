      component "view (JSP Pages)" as e9
      component "dao (DAO Classes)" as e10
      component "model (Entity Classes)" as e11
    }
  }
}
node "Database Server" as e6 <<device>> {
  node "MySQL RDBMS" as e7 <<executionEnvironment>> {
    artifact "shopman_db (tblMember4, tblProduct4, tblSalesOrder4...)" as e12
  }
}
e9 ..> e10
e9 ..> e11
e10 ..> e11
e2 -- e4 : HTTP / HTTPS\n(TCP/IP)
e4 -- e7 : JDBC\n(TCP/IP - Port 3306)
