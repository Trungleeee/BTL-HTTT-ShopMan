<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="5.0">
  <display-name>ShopMan</display-name>
  <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>
  <servlet>
    <servlet-name>login</servlet-name>
    <jsp-file>/LoginView.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>store</servlet-name>
    <jsp-file>/CustomerHomeView4.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>products</servlet-name>
    <jsp-file>/ProductSearchView4.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>product</servlet-name>
    <jsp-file>/ProductDetailView4.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>management</servlet-name>
    <jsp-file>/ManagerHomeView4.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>reports</servlet-name>
    <jsp-file>/StatisticsSelectionView4.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>customerRevenue</servlet-name>
    <jsp-file>/CustomerRevenueStatisticsView4.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>purchaseHistory</servlet-name>
    <jsp-file>/CustomerPurchaseHistoryView4.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>invoice</servlet-name>
    <jsp-file>/SalesOrderDetailView4.jsp</jsp-file>
  </servlet>
  <servlet-mapping>
    <servlet-name>login</servlet-name>
    <url-pattern>/dang-nhap</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>store</servlet-name>
    <url-pattern>/cua-hang</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>products</servlet-name>
    <url-pattern>/san-pham</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>product</servlet-name>
    <url-pattern>/san-pham/chi-tiet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>management</servlet-name>
    <url-pattern>/quan-ly</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>reports</servlet-name>
    <url-pattern>/quan-ly/bao-cao</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>customerRevenue</servlet-name>
    <url-pattern>/quan-ly/bao-cao/doanh-thu-khach-hang</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>purchaseHistory</servlet-name>
    <url-pattern>/quan-ly/khach-hang/lich-su-mua-hang</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>invoice</servlet-name>
    <url-pattern>/quan-ly/hoa-don/chi-tiet</url-pattern>
  </servlet-mapping>
  <servlet><servlet-name>session</servlet-name><jsp-file>/SessionHandler.jsp</jsp-file></servlet>
  <servlet-mapping><servlet-name>session</servlet-name><url-pattern>/api/session</url-pattern></servlet-mapping>
  <session-config><session-timeout>30</session-timeout><cookie-config><http-only>true</http-only></cookie-config><tracking-mode>COOKIE</tracking-mode></session-config>
</web-app>
